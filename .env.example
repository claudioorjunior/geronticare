# Database
DATABASE_URL="postgresql://user:password@localhost:5432/geronticare"

# Auth (Better-Auth)
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only server-side auth bypass (OPTIONAL — local dev only)
# Só ativo quando NODE_ENV=development E ambas as vars abaixo existem.
# Em produção o branch é eliminado no build (Next.js substitui NODE_ENV por "production").
# Nunca definir estas vars em produção. Os UUIDs são os do seed de dev.
DEV_OVERRIDE_USER_ID=""
DEV_OVERRIDE_INSTITUICAO_ID=""
DEV_OVERRIDE_ROLE="admin"

# S3-compatible storage (MinIO, Cloudflare R2, AWS S3, Backblaze B2)
S3_REGION="us-east-1"
S3_ENDPOINT=""              # e.g. http://localhost:9000 (MinIO) or https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="geronticare-anexos"
S3_PUBLIC_URL=""            # CDN ou domínio público para acessar anexos
