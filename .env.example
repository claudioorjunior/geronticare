# ==============================================================================
# GerontiCare — Exemplo de variáveis de ambiente
# ------------------------------------------------------------------------------
# Prefira os arquivos específicos por ambiente:
#   cp .env.development.example .env.local   -> desenvolvimento local
#   cp .env.production.example .env.production -> produção (build/start)
# Este arquivo é um resumo geral de todas as variáveis.
# ==============================================================================

# Database (obrigatório em produção; em dev com PGlite não é necessário)
DATABASE_URL="postgresql://user:password@localhost:5432/geronticare"

# Auth (Better-Auth)
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Desenvolvimento — acesso administrativo sem login.
# Só funciona com NODE_ENV=development + este flag = true (fail-closed em produção).
# DEV_AUTH_BYPASS=true
# DEV_OVERRIDE_USER_ID=   # opcional: impersonar usuário do seed

# S3-compatible storage (MinIO, Cloudflare R2, AWS S3, Backblaze B2)
S3_REGION="us-east-1"
S3_ENDPOINT=""              # e.g. http://localhost:9000 (MinIO) or https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="geronticare-anexos"
S3_PUBLIC_URL=""            # CDN ou domínio público para acessar anexos
