# ==============================================================================
# GerontiCare — Ambiente de PRODUÇÃO
# ------------------------------------------------------------------------------
# Use com `npm run build` + `npm run start` (ou Docker/instalador).
# NODE_ENV=production é definido pelo próprio Next.js em `next build/start`;
# o bypass de desenvolvimento NUNCA ativa aqui (fail-closed por construção).
# ==============================================================================

# Database (obrigatório em produção — PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host:5432/geronticare"

# Auth (Better-Auth) — gere um segredo forte: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="https://geronticare.seudominio.com.br"

# Bootstrap inicial — obrigatório antes do /setup; a CLI gera um valor aleatório
SETUP_TOKEN=""
SETUP_TOKEN_EXPIRES_AT=""

# App
NEXT_PUBLIC_APP_URL="https://geronticare.seudominio.com.br"
# O novo shell é o padrão. Use false somente para rollback temporário.
NEXT_PUBLIC_NOVO_UI=true

# Storage S3-compatible (obrigatório para anexos: MinIO, R2, S3, B2)
STORAGE_DRIVER="s3"
S3_REGION="us-east-1"
S3_ENDPOINT=""              # ex.: https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="geronticare-anexos"
S3_PUBLIC_URL=""            # CDN ou domínio público dos anexos
