# ==============================================================================
# GerontiCare — Ambiente de DESENVOLVIMENTO
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env.local` quando for desenvolver localmente.
# NODE_ENV é definido pelo próprio Next.js (`npm run dev` = development),
# não precisa ser setado aqui.
# ==============================================================================

# Acesso administrativo sem login (APENAS desenvolvimento local!)
# Exige as DUAS condições: NODE_ENV=development (automático no `npm run dev`)
# E este flag = true. Em produção (next build/start) isso nunca ativa.
DEV_AUTH_BYPASS=true

# (Opcional) Impersonar outro usuário do seed para testar papéis
# (admin, profissional, usuario). O papel e a instituição são resolvidos
# do próprio usuário no banco — deixe vazio para usar o admin padrão do seed.
# DEV_OVERRIDE_USER_ID=320471aa-5994-4886-9ee6-1cee8e7aa810

# Auth (obrigatório se DEV_AUTH_BYPASS=false, para o fluxo real de login)
AUTH_SECRET="dev-secret-nao-usar-em-producao"
AUTH_URL="http://localhost:3000"

# Bootstrap opcional durante a instalação pelo CLI
SETUP_TOKEN=""
SETUP_TOKEN_EXPIRES_AT=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Ativa o novo shell responsivo (sidebar institucional + prontuário em fichário).
NEXT_PUBLIC_NOVO_UI=true

# Storage de anexos clínicos
# 'local' (default) grava em disco; 's3' exige credenciais S3 abaixo;
# 'none' desabilita uploads com aviso na UI.
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="./storage/anexos"  # override opcional para desenvolvimento

# Storage S3-compatible (opcional em dev — usado apenas com STORAGE_DRIVER=s3)
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="geronticare-anexos"
S3_PUBLIC_URL=""
